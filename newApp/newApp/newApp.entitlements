<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- `development` is correct for BOTH configurations. Xcode rewrites this to
	     `production` at signing time when it builds with a distribution profile,
	     so the source file never says `production` and the archived binary never
	     says `development`. That substitution is exactly why `apns_env` is read
	     from the built binary's profile at runtime (see APNSEnvironment) and is
	     never derived from this file or from `#if DEBUG`. -->
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
